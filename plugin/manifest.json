{
    "id": "com.jarvis.photoassist",
    "name": "Photo Assistant",
    "version": "1.0.0",
    "main": "index.html",
    "manifestVersion": 5,
    "host": {
        "app": "PS",
        "minVersion": "24.0.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "recorderPanel",
            "label": {
                "default": "Photo Assistant"
            },
            "minimumSize": { "width": 230, "height": 250 },
            "maximumSize": { "width": 2000, "height": 2000 },
            "preferredDockedSize": { "width": 260, "height": 400 },
            "preferredFloatingSize": { "width": 320, "height": 450 },
            "main": "index.html"
        }
    ],
    "requiredPermissions": {
        "localFileSystem": "fullAccess",
        "network": {
            "domains": ["*"]
        }
    }
}
